{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "python",
      "windows": { "command": "python" },
      "osx": { "command": "python3" },
      "linux": { "command": "python3" },
      "args": [".tests/run_tests.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "FORCE_COLOR": "1" }
      },
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "clear": true,
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
